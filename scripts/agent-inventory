#!/usr/bin/env python3
"""agent-inventory - locate and view every installed skill, agent, and command.

Scans the per-agent config directories under ~ and ~/.config for the well-known
skills/, commands/, and agents/ subdirectories, resolves symlinks, and flags
broken ones. Output is grouped by agent (human) or emitted as JSON (--json) so
other agents can consume it programmatically.

Examples:
    agent-inventory                  # full listing, grouped by agent
    agent-inventory --summary        # counts only
    agent-inventory --json           # machine-readable output
    agent-inventory --broken         # only broken symlinks
    agent-inventory --agent claude --skills
"""

from __future__ import annotations

import argparse
import json
import os

HOME = os.path.expanduser("~")


def scan_entries(base_dir, rel, keep_files):
    """List entries under base_dir/rel. Returns entry dicts.

    - ``keep_files=False`` (skills): only dirs and symlinks are kept, so lock
      files like SECURITY-SKILLS.lock.json are excluded.
    - ``keep_files=True`` (commands/agents): every entry is kept.
    """
    path = os.path.join(base_dir, rel) if rel else base_dir
    if not os.path.isdir(path):
        return []
    entries = []
    for name in sorted(os.listdir(path)):
        if name.startswith("."):
            continue
        full = os.path.join(path, name)
        is_link = os.path.islink(full)
        exists = os.path.exists(full)
        broken = is_link and not exists
        if not is_link:
            kind = "dir" if os.path.isdir(full) else "file"
        else:
            kind = "broken" if broken else "symlink"
        if kind == "file" and not keep_files:
            continue
        e = {
            "name": name,
            "path": os.path.abspath(full),
            "kind": kind,
            "target": os.path.realpath(full) if is_link else None,
            "skill_md": False,
        }
        if exists and os.path.isdir(full):
            e["skill_md"] = os.path.isfile(os.path.join(full, "SKILL.md"))
        entries.append(e)
    return entries


def scan_agent(name, rel, skill_dirs, commands_dir, agents_dir, website):
    base = os.path.join(HOME, rel)
    rec = {
        "name": name,
        "path": base,
        "website": website,
        "present": os.path.isdir(base),
        "skills": [],
        "commands": [],
        "agents": [],
    }
    if not rec["present"]:
        return rec
    for s in skill_dirs:
        rec["skills"].extend(scan_entries(base, s, keep_files=False))
    if commands_dir:
        rec["commands"].extend(scan_entries(base, commands_dir, keep_files=True))
    if agents_dir:
        rec["agents"].extend(scan_entries(base, agents_dir, keep_files=True))
    return rec


def tilde(path):
    return os.path.join("~", os.path.relpath(path, HOME))


def state_label(e):
    if e["kind"] == "broken":
        return f"BROKEN -> {e['target']}"
    if e["kind"] == "symlink":
        return f"-> {e['target']}"
    if e["kind"] == "dir":
        return "ok" if e["skill_md"] else "ok (no SKILL.md)"
    return "ok"


def totals(records):
    sk = cm = ag = br = 0
    for rec in records:
        sk += len(rec["skills"])
        cm += len(rec["commands"])
        ag += len(rec["agents"])
        for col in ("skills", "commands", "agents"):
            br += sum(1 for e in rec[col] if e["kind"] == "broken")
    return sk, cm, ag, br


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="agent-inventory",
        description="Locate and view all installed skills, agents, and commands on this host.",
    )
    ap.add_argument("-a", "--agent", nargs="+", metavar="NAME", help="only scan these agents (e.g. claude codex)")
    ap.add_argument("--skills", action="store_true", help="only show the skills collection")
    ap.add_argument("--commands", action="store_true", help="only show the commands collection")
    ap.add_argument("--agents", action="store_true", help="only show the agents collection")
    ap.add_argument("--broken", action="store_true", help="only show broken symlinks")
    ap.add_argument("--summary", action="store_true", help="counts only")
    ap.add_argument("--json", action="store_true", help="machine-readable JSON output")
    ap.add_argument("--version", action="version", version="agent-inventory 1.0.0")
    args = ap.parse_args(argv)

    if args.skills or args.commands or args.agents:
        want = {c for c, f in (("skills", args.skills), ("commands", args.commands), ("agents", args.agents)) if f}
    else:
        want = {"skills", "commands", "agents"}

    records = []
    for name, rel, skill_dirs, commands_dir, agents_dir, website in AGENTS:
        if args.agent and name not in args.agent:
            continue
        rec = scan_agent(name, rel, skill_dirs, commands_dir, agents_dir, website)
        for col in ("skills", "commands", "agents"):
            if col not in want:
                rec[col] = []
            elif args.broken:
                rec[col] = [e for e in rec[col] if e["kind"] == "broken"]
        records.append(rec)

    if args.json:
        print(json.dumps({"home": HOME, "agents": records}, indent=2))
        return 0

    print(f"agent-inventory — AI agent host on {HOME}\n")
    if args.summary:
        for rec in records:
            line = f"{rec['name']:<16} {len(rec['skills']):>3} skills, {len(rec['commands']):>2} commands, {len(rec['agents']):>2} agents"
            if not rec["present"]:
                line += "   (config dir not present)"
            print(line)
    else:
        for rec in records:
            header = f"{rec['name']}  ({rec['website']})" if rec["website"] else rec["name"]
            print(header)
            print(f"  {tilde(rec['path'])}")
            if not rec["present"]:
                print("  (config dir not present)\n")
                continue
            for col, label in (("skills", "skills"), ("commands", "commands"), ("agents", "agents")):
                items = rec[col]
                if not items:
                    print(f"  {label}: none")
                    continue
                print(f"  {label} ({len(items)}):")
                width = max(len(e["name"]) for e in items)
                for e in items:
                    print(f"    {e['name']:<{width}}  {tilde(e['path'])}  {state_label(e)}")
            print()

    sk, cm, ag, br = totals(records)
    print(f"totals: {sk} skills, {cm} commands, {ag} agents, {br} broken symlinks")


if __name__ == "__main__":
    raise SystemExit(main())
